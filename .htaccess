# ============================================================
# DonaTu - Configuracion Apache / Hostinger
# ============================================================

# Bloquear acceso directo a carpetas sensibles
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear config/, database/, tests/, .claude/, .github/
    RewriteRule ^(config|database|tests|\.claude|\.github)(/.*)?$ - [F,L]
</IfModule>

# Pagina de error personalizada
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php

# Seguridad: ocultar version de PHP y servidor
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# Charset por defecto
AddDefaultCharset UTF-8
